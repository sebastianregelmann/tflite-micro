{
    "name": "tflite-micro",
    "version": "0.0.1",
    "description": "A tflite-micro fork that packs the newest files in a built format.",
    "keywords": "TensorFlow, TensorFlow Lite Micro, tflm, tflite-micro",
    "repository": {
        "type": "git",
        "url": "https://github.com/sebastianregelmann/tflite-micro.git"
    },
    "authors": [
        {
            "name": "Sebastian Regelmann",
            "url": "https://github.com/sebastianregelmann",
            "maintainer": true
        }
    ],
    "license": "Apache 2.0",
    "dependencies": {
        "ownername/print": "~1.3.0"
    },
    "build": {
        "flags": [
            "-Isrc/thirdparty",
            "-Isrc/third_party/flatbuffers/include",
            "-Isrc/third_party/gemmlowp",
            "-Isrc/third_party/kissfft",
            "-Isrc/third_party/ruy",
            "-std=gnu++17"
        ],
        "unflags": [
            "-std=gnu++11",
            "-std=gnu++14",
            "-std=c++11",
            "-std=c++14"
        ]
    },
    "frameworks": "*",
    "platforms": "*"
}